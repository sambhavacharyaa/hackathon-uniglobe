# Copy this file to .env and fill in real values. .env is gitignored.

# cPanel SMTP mailbox settings (cPanel -> Email Accounts -> Connect Devices
# -> "Mail Client Manual Settings" -> Outgoing Server)
EMAIL_HOST=mail.yourdomain.com
EMAIL_PORT=465
EMAIL_HOST_USER=you@yourdomain.com
EMAIL_HOST_PASSWORD=your-mailbox-password
# Exactly one of these should be True, matching EMAIL_PORT above
# (465 -> SSL, 587 -> TLS)
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=you@yourdomain.com

# OpenRouter (marksheet review, doubt chatbot, quiz generation, answer sheets)
# Get a key at https://openrouter.ai/keys
# Browse models (including free-tier options) at https://openrouter.ai/models
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free
